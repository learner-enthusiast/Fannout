# =============================================================================
# Root environment file for the monorepo
#
# Copy to .env and fill in values:
#   cp .env.example .env
#
# Used by: apps/api, apps/web, packages/database, packages/services, packages/logger
# Run `./setup.sh` to symlink this file into each app/package directory.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (packages/database)
# -----------------------------------------------------------------------------
# Local Postgres via docker-compose: docker compose up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fannout
# Apply pending migrations: `pnpm db:migrate` (dev, drizzle-kit) or `pnpm db:migrate:deploy` (prod/CI).

# -----------------------------------------------------------------------------
# Clerk authentication (apps/web, apps/api, packages/services)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk Dashboard → Webhooks → endpoint → Signing secret
CLERK_WEBHOOK_SIGNING_SECRET=
# Must match how users reach the web app (include port when not 80/443).
WEB_URL=http://localhost:3000
# Public API URL for webhook setup. Use your ngrok URL for local testing.
API_PUBLIC_URL=https://quaternate-charlie-unindustriously.ngrok-free.dev

# -----------------------------------------------------------------------------
# Redis (packages/redis, packages/bullmq)
# Local Redis via docker-compose: docker compose up -d
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Scheduled posts (apps/worker): upload speed estimate + lead time bounds
# SCHEDULE_UPLOAD_MBPS=20
# SCHEDULE_LEAD_MIN_SECONDS=30
# SCHEDULE_LEAD_MAX_SECONDS=1800
# REDIS_CACHE_PREFIX=fannout:cache:

# -----------------------------------------------------------------------------
# Object storage (packages/s3) — AWS S3 or any S3-compatible store.
# Local MinIO via docker-compose: docker compose up -d minio minio-init
# Console: http://localhost:9001 (login with the key/secret below)
# For AWS S3: leave S3_ENDPOINT empty and set a real region/bucket/credentials.
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
# Endpoint browsers use for presigned URLs, if different from S3_ENDPOINT
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fannout-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Inngest (packages/inngest, served by apps/api at /api/inngest)
# Local: run the dev server `npx inngest-cli@latest dev -u http://localhost:8000/api/inngest`
# Keys are required only in prod (Inngest Cloud → app → keys).
# -----------------------------------------------------------------------------
# INNGEST_APP_ID=fannout
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Social account OAuth (packages/services/oauth, apps/api)
# Callback URLs point at the API (PORT 8000) and must match the ones registered
# with each provider exactly. The web app origin is WEB_URL above (used as the
# post-connect redirect target; this is the "FRONTEND_URL").
# -----------------------------------------------------------------------------
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/oauth/linkedin/callback
LINKEDIN_SCOPES=openid profile email w_member_social
# false (default) = Share on LinkedIn product (/v2/ugcPosts, w_member_social).
# true = Community Management API (/rest/posts, /rest/videos) — only if your app has that product.
LINKEDIN_USE_COMMUNITY_API=false

# X
X_CLIENT_ID=
# Leave empty if the X app is a public client
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/oauth/x/callback
# All five are required for posting (callback fails with insufficient_scope if any are omitted).
X_SCOPES=tweet.read tweet.write users.read media.write offline.access

# YouTube / Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/youtube/callback
# yt-analytics.readonly = analytics dashboard (users reconnect to grant)
YOUTUBE_SCOPES=openid email profile https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/yt-analytics.readonly

# Facebook (Meta app → Facebook Login). Connects Facebook Pages; scopes are comma-separated.
# pages_manage_posts is required to post (including videos) to a Page. (publish_video is not a valid Login permission.)
# Using Facebook Login for Business with a config_id? Add the same permissions to that configuration instead.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/oauth/facebook/callback
# read_insights + pages_read_engagement = analytics dashboard
FACEBOOK_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_manage_posts,business_management,read_insights
FACEBOOK_GRAPH_VERSION=v23.0

# Threads (Meta app → Threads API use case; uses the separate Threads app ID/secret).
# Threads only accepts HTTPS redirect URIs — see README / use a tunnel locally.
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:8000/api/oauth/threads/callback
# threads_manage_insights = analytics dashboard
THREADS_SCOPES=threads_basic,threads_content_publish,threads_delete,threads_manage_insights

# -----------------------------------------------------------------------------
# API server (apps/api)
# -----------------------------------------------------------------------------
PORT=8000
BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Web app (apps/web)
# -----------------------------------------------------------------------------
# Next.js listen port for `pnpm dev` / `pnpm start` in apps/web (default 3000).
WEB_PORT=3000
# tRPC endpoint. Omit to use the relative path "/trpc" (requires a Next.js proxy).
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc

# Set to "true" to skip Next.js env validation during Docker/CI builds
# SKIP_ENV_VALIDATION=true

# -----------------------------------------------------------------------------
# Shared runtime (apps/api, packages/services, packages/logger)
# -----------------------------------------------------------------------------
# Valid values: development | prod  (note: "production" is NOT accepted)
NODE_ENV=development

# Optional log level: error | debug | info
# Defaults to "debug" in development, "error" in prod
# LOGGER_LEVEL=debug

# -----------------------------------------------------------------------------
# AI content generation (packages/ai) — backend only, never sent to the browser.
# -----------------------------------------------------------------------------
# Required for "Generate with AI" in Compose (OpenAI dashboard → API keys).
OPENAI_API_KEY=
# Model id; defaults to the cost-efficient text model.
OPENAI_MODEL=gpt-6-luna
# Log prompts and AI outputs (they contain user content). Local debugging only.
AI_LOG_PROMPTS=false

# -----------------------------------------------------------------------------
# API keys + rate limiting (packages/services/api-keys, rate-limit)
# -----------------------------------------------------------------------------
# HMAC pepper for API keys — only HMAC(key, pepper) is stored. openssl rand -base64 32
# Changing it invalidates every existing API key.
API_KEY_PEPPER=
# Set to false only for local debugging.
RATE_LIMIT_ENABLED=true
