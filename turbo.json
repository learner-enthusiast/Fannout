{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint",
        "docs:agent:check"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {},
    "db:migrate": {},
    "test": {},
    "db:reset": {
      "cache": false
    },
    "docs:agent:check": {
      "cache": false
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "FANNOUT_DEV_AUTH_BYPASS",
    "SKIP_ENV_VALIDATION",
    "BASE_URL",
    "WEB_URL",
    "FFPROBE_PATH",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "AI_LOG_PROMPTS",
    "LINKEDIN_USE_COMMUNITY_API",
    "API_KEY_PEPPER",
    "RATE_LIMIT_ENABLED"
  ]
}
