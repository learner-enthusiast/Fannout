{
  "name": "fannout",
  "private": true,
  "scripts": {
    "build": "dotenv -- turbo build",
    "dev": "turbo dev",
    "inngest:dev": "npx inngest-cli@latest dev",
    "db:generate": "dotenv -- turbo db:generate",
    "db:migrate": "dotenv -- turbo db:migrate",
    "db:reset": "dotenv -- turbo db:reset",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "docs:agent": "pnpm --filter @repo/api exec dotenv -e ../../.env -- tsx ../../scripts/generate-agent-docs.ts",
    "docs:agent:check": "pnpm --filter @repo/api exec dotenv -e ../../.env -- tsx ../../scripts/generate-agent-docs.ts --check"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
